{
  "name": "inhub-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-inhub \"vitest run tests/rules\"",
    "test:e2e": "node scripts/e2e-emulator.mjs",
    "emulators": "firebase emulators:start --project demo-inhub",
    "bootstrap": "node scripts/bootstrap.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-email/components": "^1.0.12",
    "animejs": "^4.5.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
